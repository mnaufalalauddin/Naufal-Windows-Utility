<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Naufal_Windows_Tech_s_Powertoys</RootNamespace>
    <AssemblyName>HeaderLayout.Tests</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <ApplicationDefinition Include="..\..\App.xaml" Link="App.xaml" />
    <Page Include="..\..\MainWindow.xaml" Link="MainWindow.xaml" />
    <Compile Include="..\..\MainWindow.HeaderLayout.cs" Link="MainWindow.HeaderLayout.cs" />
    <Compile Include="..\..\MainWindow.Navigation.cs" Link="MainWindow.Navigation.cs" />
    <Compile Include="..\..\HeaderLayoutPolicy.cs" Link="HeaderLayoutPolicy.cs" />
    <Compile Include="..\..\UiDisplaySettings.cs" Link="UiDisplaySettings.cs" />
    <Compile Include="..\..\CatalogDisplayNames.cs" Link="CatalogDisplayNames.cs" />
    <Compile Include="..\..\UiTextKeys.cs" Link="UiTextKeys.cs" />
    <Compile Include="..\..\SystemReportEntry.cs" Link="SystemReportEntry.cs" />
    <Compile Include="..\..\SmartAttribute.cs" Link="SmartAttribute.cs" />
    <Compile Include="..\..\DiskReportPresentation.cs" Link="DiskReportPresentation.cs" />
    <Compile Include="..\..\DiskInfoView.cs" Link="DiskInfoView.cs" />
    <Compile Include="..\..\ToolWindow.cs" Link="ToolWindow.cs" />
    <Compile Include="..\..\AppWindowIcon.cs" Link="AppWindowIcon.cs" />
    <Compile Include="..\..\DialogMessageContent.cs" Link="DialogMessageContent.cs" />
    <Compile Include="..\..\InlineAnalysisProgress.cs" Link="InlineAnalysisProgress.cs" />
    <Compile Include="..\..\CatalogProgressItem.cs" Link="CatalogProgressItem.cs" />
    <Compile Include="..\..\GpuDriverUpdateView.cs" Link="GpuDriverUpdateView.cs" />
    <Compile Include="..\..\GpuDriverHeader.cs" Link="GpuDriverHeader.cs" />
    <Compile Include="..\..\GpuDriverChannels.cs" Link="GpuDriverChannels.cs" />
    <Compile Include="..\..\GpuDriverUpdates.cs" Link="GpuDriverUpdates.cs" />
    <Compile Include="..\..\GpuDriverVersionVerification.cs" Link="GpuDriverVersionVerification.cs" />
    <Content Include="..\..\Assets\NaufalWindowsPowertoys.ico" Link="Assets\NaufalWindowsPowertoys.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Linked XAML compiles to XBF in TargetDir, but is not automatically
       included by the source-only host's Native AOT publish pipeline. -->
  <Target Name="PublishLinkedHostXaml" AfterTargets="Publish">
    <ItemGroup>
      <_HostXaml Include="$(TargetDir)App.xbf;$(TargetDir)MainWindow.xbf;$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostXaml)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
