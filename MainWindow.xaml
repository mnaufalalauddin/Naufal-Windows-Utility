<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Naufal_Windows_Tech_s_Powertoys.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Naufal_Windows_Tech_s_Powertoys"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Naufal Windows Utility">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Background="#F4F7FC" RequestedTheme="Light">
        <Grid.Resources>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#F9FBFE"/>
                <Setter Property="BorderBrush" Value="#7F8C9D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ReferenceButtonStyle}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="UtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>


            <Style x:Key="PrimaryToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#2E66E5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2E66E5"/>
            </Style>

            <Style x:Key="DangerToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#B91C23"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#B91C23"/>
            </Style>

            <Style x:Key="SuccessToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#16833A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#16833A"/>
            </Style>

            <Style x:Key="WarningToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Background" Value="#BE5705"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#BE5705"/>
            </Style>

            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#EDF2F8"/>
                <Setter Property="BorderBrush" Value="#7F8C9D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="MinHeight" Value="58"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- APPLICATION HEADER -->
        <Border Grid.Row="0" MinHeight="86" Background="#F9FBFE" BorderBrush="#D2DAE5" BorderThickness="0,0,0,1">
            <Grid>
                <Border Width="6" HorizontalAlignment="Left" Background="#2E66E5"/>

                <Grid x:Name="HeaderLayout" Margin="24,10,20,10" SizeChanged="HeaderLayout_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="HeaderClock" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2" Margin="0,0,20,0">
                        <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="25" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DateText" Text="Sunday, 30 August 2026" FontSize="11"
                               Foreground="#34455C" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SessionText" Text="Time spent 00:00:00" FontSize="11"
                               Foreground="#1B4D91" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid x:Name="HeaderSettings" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" ColumnSpacing="8" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                            <Button x:Name="ThemeButton" Grid.Row="1" Grid.Column="1" Content="☀" Width="38" Height="32" MinHeight="32" CornerRadius="0"
                                    Click="ThemeButton_Click" AutomationProperties.Name="Toggle light or dark mode"/>
                            <Button x:Name="TextScaleButton" Grid.Row="1" Grid.Column="2" Width="38" Height="32" MinHeight="32" CornerRadius="0" FontWeight="Bold"
                                    Click="TextScaleButton_Click" AutomationProperties.Name="Text scaling">
                                <TextBlock x:Name="TextScaleGlyph" Text="A" TextDecorations="Underline"/>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ResetTextScale_Invoked"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                    </Grid>

                </Grid>
            </Grid>
        </Border>

        <ContentControl x:Name="MainAnalysisHost" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" Margin="18,4"/>
        <NavigationView x:Name="MainNavigation" Grid.Row="2" PaneDisplayMode="Auto"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        OpenPaneLength="256" CompactPaneLength="48" ExpandedModeThresholdWidth="1100"
                        CompactModeThresholdWidth="640" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneTitle="Windows Utility" SelectionChanged="MainNavigation_SelectionChanged" ItemInvoked="MainNavigation_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" Icon="Home" IsSelected="True"/>
                <NavigationViewItem Content="System Repair" Tag="Repair" Icon="Repair"/>
                <NavigationViewItem Content="System Info" Tag="Info" Icon="Document"/>
                <NavigationViewItem Content="Windows Security" Tag="Security" Icon="Permissions"/>
                <NavigationViewItem Content="Advanced Windows Tweaks" Tag="Advanced" Icon="Setting"/>
            </NavigationView.MenuItems>
            <!-- The full-width Grid owns centering of the capped content. A capped
                 direct ScrollViewer child is offset by its narrow DesiredSize but
                 arranged wider, which can push the shared toolbar off-screen. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <Grid>
                <StackPanel Margin="24,16,24,24" Spacing="24" MaxWidth="1320" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="8" RowSpacing="8" x:Name="UtilityButtonsGrid" SizeChanged="HomeGrid_SizeChanged">
                        <Button x:Name="AboutButton" Content="About"
                                        Style="{StaticResource UtilityButtonStyle}" Click="AboutButton_Click"/>
                        <Button x:Name="TaskStatusButton" Content="Task Monitoring"
                                        Style="{StaticResource UtilityButtonStyle}"
                                        Click="TaskStatusButton_Click"
                                        AutomationProperties.Name="Task Monitoring"/>

                        <Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" Style="{StaticResource UtilityButtonStyle}"/>
                    </Grid>
                    <StackPanel x:Name="HomePage" Spacing="20">
                        <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Your Windows configuration, at a glance." TextWrapping="Wrap"/>
                        <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="18,16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Performance profile" FontSize="22" FontWeight="SemiBold"/>

                            <Grid x:Name="ProfileChoicesGrid" ColumnSpacing="8" RowSpacing="8" SizeChanged="HomeGrid_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CompetitiveProfileButton" Grid.Column="0"
                                        Content="Competitive Gaming" Tag="Competitive Gaming"
                                        Click="ProfileSelectionButton_Click"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"/>
                                <Button x:Name="OptimizedProfileButton" Grid.Column="1"
                                        Content="Optimized Gaming" Tag="Optimized Gaming"
                                        Click="ProfileSelectionButton_Click"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"/>
                                <Button x:Name="BalancedProfileButton" Grid.Column="2"
                                        Content="Balanced" Tag="Balanced"
                                        Click="ProfileSelectionButton_Click"
                                        Style="{StaticResource ToolButtonStyle}" Margin="0"/>
                            </Grid>

                            <Button x:Name="ApplyProfileButton" Content="SELECT A PROFILE" Height="34"
                                    Click="ApplyProfileButton_Click" IsEnabled="False"
                                    Style="{StaticResource ToolButtonStyle}" Margin="0"/>

                            <Border Background="#EDF2F8" BorderBrush="#7F8C9D" BorderThickness="1" Padding="14,12" MinHeight="88">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CURRENT PROFILE" FontSize="11" Foreground="#33465F"/>
                                    <TextBlock x:Name="CurrentProfileValueText" Text="Initializing..." FontSize="16" FontWeight="Bold"
                                               Foreground="#C15B00" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Applies the complete selected profile: MMCSS, processor power policy, BCD/timer, TCP/QoS and RSC. Competitive and Optimized Gaming use Ultimate Performance; Balanced uses the Windows Balanced plan."
                                       FontSize="12" Foreground="#33465F" TextWrapping="Wrap"/>

                            <TextBlock Text="Every apply operation requires confirmation and Administrator rights. Game DVR remains independently controlled from Gaming Tweaks. Restart Windows after a profile change."
                                       FontSize="12" Foreground="#33465F" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                        <TextBlock Text="System status" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UpdatedText" Text="Checking current configuration..." FontSize="12"/>
                        <Grid x:Name="StatusCardsGrid" ColumnSpacing="10" RowSpacing="10" SizeChanged="HomeGrid_SizeChanged"><Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Power plan" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="PowerPlanValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="MMCSS" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="MmcssValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Game Mode" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="GameModeValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Hardware-accelerated GPU scheduling" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="HagsValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Windowed optimizations" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="WindowedValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Multiplane overlay" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="MpoValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="SysMain" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="SysMainValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Uptime" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="UptimeValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Processes" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="ProcessValueText" Text="Checking..." FontSize="15" TextWrapping="Wrap"/></StackPanel></Border></Grid>
                        <TextBlock Text="Restart Windows after applying a performance profile or any option marked restart-sensitive." TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="Quick actions" FontSize="22" FontWeight="SemiBold"/>
                        <Grid x:Name="QuickActionsGrid" ColumnSpacing="8" RowSpacing="8" SizeChanged="HomeGrid_SizeChanged">
                            <Button Content="Quick Repair" Click="HomeQuickRepair_Click" Style="{StaticResource ToolButtonStyle}"/>
                            <Button Content="System Report" Click="HomeSystemReport_Click" Style="{StaticResource ToolButtonStyle}"/>
                            <Button Content="Clear GPU Shader Cache" Click="HomeShaderCache_Click" Style="{StaticResource ToolButtonStyle}"/>
                        </Grid>
                        <Button x:Name="LegacyWindowsPanelsButton" Content="Legacy Windows Panels"
                                        Click="LegacyWindowsPanelsButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
                        <Expander Header="Live telemetry" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid x:Name="LiveChartsGrid" ColumnSpacing="10" RowSpacing="10" SizeChanged="HomeGrid_SizeChanged"><Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="8"><TextBlock Text="CPU"/><TextBlock x:Name="CpuValueText" Text="Checking..."/><Grid x:Name="CpuGraphHost"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Memory"/><TextBlock x:Name="RamValueText" Text="Checking..."/><Grid x:Name="RamGraphHost"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="8"><TextBlock Text="GPU 3D"/><TextBlock x:Name="GpuValueText" Text="Checking..."/><Grid x:Name="GpuGraphHost"/></StackPanel></Border>
<Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Network RX / TX"/><TextBlock x:Name="NetworkValueText" Text="Checking..."/><Grid x:Name="NetworkGraphHost"/></StackPanel></Border></Grid>
                        </Expander>
                        <Expander Header="Technical details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBox x:Name="LiveDetailText" Text="Checking configuration..." IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Height="300"
                                     Background="#07111F" Foreground="#F5F7FA" Padding="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Expander>
                    </StackPanel>
                    <StackPanel x:Name="RepairPage" Visibility="Collapsed" Spacing="16" MaxWidth="920" HorizontalAlignment="Left"><TextBlock Text="System Repair" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Repair Windows components. Each operation explains its scope before it starts." TextWrapping="Wrap"/>
<Button x:Name="FullRepairButton" Content="Full Repair"
                                        Click="FullRepairButton_Click"
                                        Style="{StaticResource PrimaryToolButtonStyle}"/>
<Button x:Name="QuickRepairButton" Content="Quick Repair"
                                        Click="QuickRepairButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="WindowsUpdateFixButton" Content="Windows Update Fix"
                                        Click="WindowsUpdateFixButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="MicrosoftStoreFixButton" Content="Microsoft Store Fix"
                                        Click="MicrosoftStoreFixButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="ExplorerFixButton" Content="Explorer Fix"
                                        Click="ExplorerFixButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
</StackPanel>
<StackPanel x:Name="InfoPage" Visibility="Collapsed" Spacing="16" MaxWidth="920" HorizontalAlignment="Left"><TextBlock Text="System Info" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Inspect disks, system reports, and activation status without changing Windows." TextWrapping="Wrap"/>
<Button x:Name="DiskInfoButton" Content="Disk Info"
                                        Click="DiskInfoButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="SystemReportButton" Content="System Report"
                                        Click="SystemReportButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="WindowsActivationButton" Content="Windows Activation Status"
                                        Click="WindowsActivationButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Expander Header="Action Inventory / Shared Targets" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="10">
        <Button Content="Load action inventory" Click="CatalogInventory_Click" Style="{StaticResource ToolButtonStyle}"/>
        <TextBlock x:Name="CatalogInventoryStatus" Text="Read-only catalog definitions; no Windows scan or changes." TextWrapping="Wrap"/>
        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="CatalogInventoryText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        </ScrollViewer>
    </StackPanel>
</Expander>
<Button x:Name="OfficeActivationButton" Content="Office Activation Status"
                                        Click="OfficeActivationButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
</StackPanel>
<StackPanel x:Name="SecurityPage" Visibility="Collapsed" Spacing="16" MaxWidth="920" HorizontalAlignment="Left"><TextBlock Text="Windows Security" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Review protection and encryption. Security changes require confirmation; understand the consequences before proceeding." TextWrapping="Wrap"/>
<Button x:Name="DisableDefenderButton" Content="Disable Defender"
                                        Click="DisableDefenderButton_Click"
                                        Style="{StaticResource DangerToolButtonStyle}"/>
<Button x:Name="RestoreDefenderButton" Content="Restore Defender"
                                        Click="RestoreDefenderButton_Click"
                                        Style="{StaticResource SuccessToolButtonStyle}"/>
<Button x:Name="BitLockerManagerButton" Content="BitLocker Manager"
                                        Click="BitLockerManagerButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="SmartAppControlButton" Content="Smart App Control"
                                        Click="SmartAppControlButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Expander Header="Security status / LSA protection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel x:Name="SecurityEvidencePanel" Spacing="12">
        <Button Content="Load security status" Click="SecurityMitigations_Click" Style="{StaticResource ToolButtonStyle}"/>
    </StackPanel>
</Expander>
</StackPanel>
<StackPanel x:Name="AdvancedPage" Visibility="Collapsed" Spacing="16" MaxWidth="920" HorizontalAlignment="Left"><TextBlock Text="Advanced Windows Tweaks" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Explore optional configuration, applications, drivers, and runtime tools. Review each warning and keep a recovery backup." TextWrapping="Wrap"/>
<Button x:Name="EssentialTweaksButton" Content="Essential Windows Tweaks"
                                        Click="EssentialTweaksButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="GamingTweaksButton" Content="Gaming Tweaks"
                                        Click="GamingTweaksButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="RuntimeCompatibilityButton" Content="Games Runtime &amp; Compatibility Check"
                                        Click="RuntimeCompatibilityButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="GpuDriverManagerButton" Content="GPU Driver Manager"
                                        Click="GpuDriverManagerButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="DebloatButton" Content="Advanced Windows Tweaks &amp; De-Bloat"
                                        Click="DebloatButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
<Button x:Name="MsiModeUtilityButton" Content="MSI Mode Utility"
                                        Click="MsiModeUtilityButton_Click"
                                        Style="{StaticResource ToolButtonStyle}"/>
</StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
